<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:OrquestadorFrontend.Core"
             xmlns:documents="clr-namespace:OrquestadorFrontend.Features.Documents"
             xmlns:whistleblower="clr-namespace:OrquestadorFrontend.Features.Whistleblower"
             x:Class="OrquestadorFrontend.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Order matters: tokens must load before the styles that
                    consume them. Colors first (Shape/Spacing/Elevation reach
                    into Colors via Scrim), then the shape/spacing/elevation
                    scales, then the typography styles (which read OnSurface),
                    and finally the component styles (which compose all of
                    the above).
                -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Shape.xaml" />
                <ResourceDictionary Source="Resources/Styles/Spacing.xaml" />
                <ResourceDictionary Source="Resources/Styles/Elevation.xaml" />
                <ResourceDictionary Source="Resources/Styles/Typography.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ResultState converters used by every screen that loads data. -->
            <core:IsLoadingConverter x:Key="IsLoadingConverter" />
            <core:IsDataConverter x:Key="IsDataConverter" />
            <core:IsEmptyConverter x:Key="IsEmptyConverter" />
            <core:IsFailureConverter x:Key="IsFailureConverter" />
            <core:DataValueConverter x:Key="DataValueConverter" />
            <core:FailureMessageConverter x:Key="FailureMessageConverter" />
            <core:InverseBoolConverter x:Key="InverseBoolConverter" />

            <!-- Feature-specific converters -->
            <documents:ReportKindLabelConverter x:Key="ReportKindLabelConverter" />
            <whistleblower:WhistleblowerStatusLabelConverter x:Key="WhistleblowerStatusLabelConverter" />
            <whistleblower:WhistleblowerStatusColorConverter x:Key="WhistleblowerStatusColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
