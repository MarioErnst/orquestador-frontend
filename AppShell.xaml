<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:auth="clr-namespace:OrquestadorFrontend.Features.Auth"
       xmlns:home="clr-namespace:OrquestadorFrontend.Features.Home"
       xmlns:reports="clr-namespace:OrquestadorFrontend.Features.Reports"
       xmlns:documents="clr-namespace:OrquestadorFrontend.Features.Documents"
       xmlns:notifications="clr-namespace:OrquestadorFrontend.Features.Notifications"
       x:Class="OrquestadorFrontend.AppShell"
       Title="App ACHS Directivos"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
       Shell.ForegroundColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource DarkOnSurface}}"
       Shell.TitleColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource DarkOnSurface}}"
       Shell.NavBarHasShadow="False">

    <Shell.Resources>
        <!-- Tab bar surface: a tonal SurfaceContainer level so it lifts
             gently from the page background in both schemes. Active tab uses
             Primary; inactive tabs sit on OnSurfaceVariant for legibility
             without competing with the active one. -->
        <Style TargetType="TabBar">
            <Setter Property="Shell.TabBarBackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource SurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}" />
            <Setter Property="Shell.TabBarForegroundColor"
                    Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
            <Setter Property="Shell.TabBarUnselectedColor"
                    Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}" />
            <Setter Property="Shell.TabBarTitleColor"
                    Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
        </Style>

        <!--
            Icon font glyphs for the bottom tab bar.

            MAUI Shell on iOS does not honour TabBarUnselectedColor for
            FontImageSource without an explicit Color set on the source
            itself (dotnet/maui issues #10350, #20866). The Size is also
            required: without it the glyph renders at 0px on iOS and
            pixelated on Android. Both are set explicitly here to avoid
            the silent invisible-icon failure mode.
        -->
        <FontImageSource x:Key="IconHome"
                         FontFamily="MaterialIcons"
                         Glyph="&#xe88a;"
                         Size="24"
                         Color="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}" />
        <FontImageSource x:Key="IconReports"
                         FontFamily="MaterialIcons"
                         Glyph="&#xe6dd;"
                         Size="24"
                         Color="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}" />
        <FontImageSource x:Key="IconDocuments"
                         FontFamily="MaterialIcons"
                         Glyph="&#xe873;"
                         Size="24"
                         Color="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}" />
        <FontImageSource x:Key="IconNotifications"
                         FontFamily="MaterialIcons"
                         Glyph="&#xe7f4;"
                         Size="24"
                         Color="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}" />
    </Shell.Resources>

    <!-- 1. Entry point: Login.
         The Shell starts here. Sign-in navigates to //main/home. -->
    <ShellContent Title="Iniciar sesión"
                  Route="login"
                  ContentTemplate="{DataTemplate auth:LoginPage}"
                  Shell.NavBarIsVisible="False"
                  Shell.TabBarIsVisible="False" />

    <!-- 2. Main app: TabBar with the four primary sections. -->
    <TabBar Route="main">

        <Tab Title="Inicio" Route="home" Icon="{StaticResource IconHome}">
            <ShellContent ContentTemplate="{DataTemplate home:HomePage}" />
        </Tab>

        <Tab Title="Reportes" Route="reports" Icon="{StaticResource IconReports}">
            <ShellContent ContentTemplate="{DataTemplate reports:ReportsListPage}" />
        </Tab>

        <Tab Title="Documentos" Route="documents" Icon="{StaticResource IconDocuments}">
            <ShellContent ContentTemplate="{DataTemplate documents:DocumentsListPage}" />
        </Tab>

        <Tab Title="Alertas" Route="notifications" Icon="{StaticResource IconNotifications}">
            <ShellContent ContentTemplate="{DataTemplate notifications:NotificationsPage}" />
        </Tab>

    </TabBar>

</Shell>
