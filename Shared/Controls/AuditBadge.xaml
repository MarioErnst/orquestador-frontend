<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrquestadorFrontend.Shared.Controls.AuditBadge"
             x:Name="Root">

    <!--
        "Acceso registrado" pill for the Whistleblower channel. Sober tone,
        institutional — never alarming. Per Propuesta 2 §5.6 it is an honest
        signal to the user that every access is audited.
    -->
    <Border Stroke="Transparent"
            StrokeThickness="0"
            BackgroundColor="{StaticResource SecondaryContainer}"
            Padding="14,6"
            HorizontalOptions="Start">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="999" />
        </Border.StrokeShape>
        <Label Text="{Binding Label, Source={x:Reference Root}}"
               Style="{StaticResource LabelMedium}"
               TextColor="{StaticResource OnSecondaryContainer}" />
    </Border>

</ContentView>
