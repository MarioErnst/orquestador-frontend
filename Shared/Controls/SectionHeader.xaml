<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrquestadorFrontend.Shared.Controls.SectionHeader"
             x:Name="Root">

    <Grid Padding="0,4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <VerticalStackLayout Grid.Column="0" Spacing="2">
            <Label Text="{Binding Title, Source={x:Reference Root}}"
                   Style="{StaticResource TitleMedium}" />
            <Label Text="{Binding Subtitle, Source={x:Reference Root}}"
                   Style="{StaticResource BodySmall}"
                   TextColor="{StaticResource OnSurfaceVariant}"
                   IsVisible="{Binding HasSubtitle, Source={x:Reference Root}}" />
        </VerticalStackLayout>

        <ContentView Grid.Column="1"
                     Content="{Binding Trailing, Source={x:Reference Root}}"
                     VerticalOptions="Center" />
    </Grid>

</ContentView>
