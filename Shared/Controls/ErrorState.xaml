<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrquestadorFrontend.Shared.Controls.ErrorState"
             x:Name="Root">

    <Grid Padding="24">
        <VerticalStackLayout Spacing="12"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">
            <Label Text="{Binding Title, Source={x:Reference Root}}"
                   Style="{StaticResource TitleMedium}"
                   TextColor="{StaticResource Error}"
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding Message, Source={x:Reference Root}}"
                   Style="{StaticResource BodyMedium}"
                   TextColor="{StaticResource OnSurfaceVariant}"
                   HorizontalTextAlignment="Center" />
            <Button Text="Reintentar"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding RetryCommand, Source={x:Reference Root}}"
                    IsVisible="{Binding RetryCommand, Source={x:Reference Root}, Converter={StaticResource IsDataConverter}}" />
        </VerticalStackLayout>
    </Grid>

</ContentView>
