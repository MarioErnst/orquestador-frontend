<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrquestadorFrontend.Shared.Controls.NoPermissionState"
             x:Name="Root">

    <Grid Padding="24">
        <VerticalStackLayout Spacing="8"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">
            <Label Text="{Binding Title, Source={x:Reference Root}}"
                   Style="{StaticResource TitleMedium}"
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding Message, Source={x:Reference Root}}"
                   Style="{StaticResource BodyMedium}"
                   TextColor="{StaticResource OnSurfaceVariant}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>

</ContentView>
