<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <!-- iOS requires macOS toolchain; exclude on Linux to allow local Android-only builds -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Linux'))">net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>OrquestadorFrontend</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>App ACHS Directivos</ApplicationTitle>
    <ApplicationId>cl.achs.directivos.orquestador</ApplicationId>

    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Launcher icon (placeholder ACHS verde — icono oficial pendiente segun decision de marca) -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#13C045" />

    <!-- Splash screen con fondo verde Masterbrand -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#13C045" BaseSize="128,128" />

    <!--
        Brand assets shipped with the app. Without these explicit globs the
        MAUI SingleProject default include for fonts/images is bypassed by
        the per-platform itemgroups above and the assets silently fail to
        ship: the app then runs with the system font and without the ACHS
        logo or Material Icons glyph font. The cost of being explicit is
        less than the cost of the regression.
    -->
    <MauiFont Include="Resources\Fonts\*" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>

  <ItemGroup>
    <!--
        Versions pinned per CLAUDE.md section 8 (no latest, no open ranges).
        Microsoft.Maui.Controls 10.0.70 is the latest stable on the .NET 10
        wave and is required to unlock CommunityToolkit.Maui 14.x (which
        depends on >= 10.0.60). The local maui-android workload manifest is
        still 10.0.20, but the runtime package ships ahead of the workload
        and the build works with that combination. Rationale and follow-up
        in documentacion/decisiones/maui-controls-pin-2026-06.md.
    -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.70" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!--
        Visual polish stack (CLAUDE.md section 1 — additions to the fixed
        stack, authorised by the human in the restyle session 2026-06-03).
        Each dependency justified in documentacion/decisiones/visual-deps-2026-06.md.
    -->
    <PackageReference Include="CommunityToolkit.Maui" Version="14.1.1" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.4" />
    <PackageReference Include="UraniumUI.Material" Version="2.16.0" />
  </ItemGroup>

</Project>
