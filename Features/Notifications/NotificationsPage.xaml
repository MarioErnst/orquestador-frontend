<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OrquestadorFrontend.Features.Notifications"
             xmlns:shared="clr-namespace:OrquestadorFrontend.Shared.Controls"
             xmlns:models="clr-namespace:OrquestadorFrontend.Data.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="OrquestadorFrontend.Features.Notifications.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title="Notificaciones">

    <Shell.TitleView>
        <shared:AppBarTitle Title="Notificaciones" />
    </Shell.TitleView>


    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Preferencias" Command="{Binding OpenPreferencesCommand}" />
    </ContentPage.ToolbarItems>

    <Grid Padding="16">
        <shared:LoadingState IsVisible="{Binding State, Converter={StaticResource IsLoadingConverter}}" />
        <shared:ErrorState   IsVisible="{Binding State, Converter={StaticResource IsFailureConverter}}"
                             Message="{Binding State, Converter={StaticResource FailureMessageConverter}}"
                             RetryCommand="{Binding LoadCommand}" />
        <shared:EmptyState   IsVisible="{Binding State, Converter={StaticResource IsEmptyConverter}}"
                             Title="No hay notificaciones"
                             Message="Cuando llegue algo, lo verás acá." />

        <CollectionView IsVisible="{Binding State, Converter={StaticResource IsDataConverter}}"
                        ItemsSource="{Binding State, Converter={StaticResource DataValueConverter}}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:NotificationItem">
                    <Border Style="{StaticResource CardBorder}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=OpenCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Border.Behaviors>
                            <toolkit:TouchBehavior DefaultAnimationDuration="120"
                                                   PressedScale="0.97"
                                                   PressedOpacity="0.9" />
                        </Border.Behaviors>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding Title}"
                                       Style="{StaticResource TitleSmall}" />
                                <Label Text="{Binding Body}"
                                       Style="{StaticResource BodySmall}"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}" />
                            </VerticalStackLayout>
                            <Ellipse Grid.Column="1"
                                     WidthRequest="10"
                                     HeightRequest="10"
                                     Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                     VerticalOptions="Start"
                                     IsVisible="{Binding Read, Converter={StaticResource InverseBoolConverter}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
