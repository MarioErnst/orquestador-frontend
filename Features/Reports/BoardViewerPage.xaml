<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OrquestadorFrontend.Features.Reports"
             xmlns:shared="clr-namespace:OrquestadorFrontend.Shared.Controls"
             x:Class="OrquestadorFrontend.Features.Reports.BoardViewerPage"
             x:DataType="vm:BoardViewerViewModel"
             Title="Tablero"
             Shell.TabBarIsVisible="False">

    <Grid>
        <shared:LoadingState IsVisible="{Binding State, Converter={StaticResource IsLoadingConverter}}" />
        <shared:ErrorState   IsVisible="{Binding State, Converter={StaticResource IsFailureConverter}}"
                             Message="{Binding State, Converter={StaticResource FailureMessageConverter}}"
                             RetryCommand="{Binding LoadCommand}" />
        <shared:EmptyState   IsVisible="{Binding State, Converter={StaticResource IsEmptyConverter}}"
                             Title="Tablero no disponible"
                             Message="No encontramos el tablero solicitado." />

        <Grid IsVisible="{Binding State, Converter={StaticResource IsDataConverter}}"
              RowDefinitions="Auto,*">
            <VerticalStackLayout Grid.Row="0" Padding="16" Spacing="4"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}">
                <Label Text="{Binding Board.Name}"
                       Style="{StaticResource HeadlineSmall}" />
                <Label Text="{Binding Board.Description}"
                       Style="{StaticResource BodyMedium}"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}" />
            </VerticalStackLayout>

            <!-- PROTOTYPE: the real viewer is a HybridWebView hosting the
                 powerbi-client JavaScript library (there is no native Power BI
                 control for MAUI); the backend supplies embedUrl and a
                 short-lived embed token. The placeholder makes it clear that the
                 board chrome is the app's, not the BI engine's. -->
            <Border Grid.Row="1"
                    Margin="16"
                    Stroke="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource DarkOutlineVariant}}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerHigh}, Dark={StaticResource DarkSurfaceContainerHigh}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Padding="24">
                    <Label Text="Tablero Power BI embebido"
                           Style="{StaticResource TitleMedium}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="(placeholder de prototipo)"
                           Style="{StaticResource BodySmall}"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="En producción aquí se renderiza el tablero con un token de embedding generado por el backend."
                           Style="{StaticResource BodySmall}"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
