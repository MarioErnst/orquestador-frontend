<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OrquestadorFrontend.Features.Reports"
             xmlns:shared="clr-namespace:OrquestadorFrontend.Shared.Controls"
             x:Class="OrquestadorFrontend.Features.Reports.BoardViewerPage"
             x:DataType="vm:BoardViewerViewModel"
             Title="Tablero"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid Padding="0">
        <shared:LoadingState IsVisible="{Binding State, Converter={StaticResource IsLoadingConverter}}" />
        <shared:ErrorState   IsVisible="{Binding State, Converter={StaticResource IsFailureConverter}}"
                             Message="{Binding State, Converter={StaticResource FailureMessageConverter}}"
                             RetryCommand="{Binding LoadCommand}" />
        <shared:EmptyState   IsVisible="{Binding State, Converter={StaticResource IsEmptyConverter}}"
                             Title="Tablero no disponible"
                             Message="No encontramos el tablero solicitado." />

        <Grid IsVisible="{Binding State, Converter={StaticResource IsDataConverter}}"
              RowDefinitions="Auto,*">
            <!-- Header with board metadata -->
            <VerticalStackLayout Grid.Row="0" Padding="16" Spacing="4"
                                 BackgroundColor="{StaticResource Surface}">
                <Label Text="{Binding State, Converter={StaticResource DataValueConverter}, StringFormat='{0}'}"
                       IsVisible="False" />
                <Label Style="{StaticResource HeadlineSmall}">
                    <Label.Text>
                        <Binding Path="State" Converter="{StaticResource DataValueConverter}" StringFormat="{}{0}">
                            <Binding.ConverterParameter>
                                <x:String>Name</x:String>
                            </Binding.ConverterParameter>
                        </Binding>
                    </Label.Text>
                </Label>
            </VerticalStackLayout>

            <!-- PROTOTYPE: real Power BI Embedded SDK with token generated by
                 the backend goes here. The placeholder makes it clear that the
                 board chrome is the app's, not the BI engine's. -->
            <Border Grid.Row="1"
                    Margin="16"
                    Stroke="{StaticResource OutlineVariant}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource SurfaceVariant}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Padding="24">
                    <Label Text="Tablero Power BI embebido"
                           Style="{StaticResource TitleMedium}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="(placeholder de prototipo)"
                           Style="{StaticResource BodySmall}"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="En producción aquí se renderiza el tablero con un token de embedding generado por el backend."
                           Style="{StaticResource BodySmall}"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
