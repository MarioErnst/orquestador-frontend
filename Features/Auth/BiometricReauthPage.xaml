<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrquestadorFrontend.Features.Auth.BiometricReauthPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <BoxView Grid.Row="0"
                 HeightRequest="6"
                 BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />

        <VerticalStackLayout Grid.Row="1"
                             Spacing="{StaticResource Spacing20}"
                             Padding="32,0"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">

            <Border WidthRequest="96"
                    HeightRequest="96"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryContainer}, Dark={StaticResource DarkPrimaryContainer}}"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="48" />
                </Border.StrokeShape>
                <Label Text="&#xe87c;"
                       FontFamily="MaterialIcons"
                       FontSize="44"
                       TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainer}, Dark={StaticResource DarkOnPrimaryContainer}}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Spacing="{StaticResource Spacing8}">
                <Label Text="Confirmá tu identidad"
                       Style="{StaticResource HeadlineMedium}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Usá la biometría de tu dispositivo para continuar."
                       Style="{StaticResource BodyLarge}"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2"
                             Spacing="{StaticResource Spacing12}"
                             Padding="24,16,24,32">
            <Button Text="Usar biometría"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalOptions="Fill"
                    Command="{Binding ConfirmCommand}" />
            <Button Text="Usar otra cuenta"
                    Style="{StaticResource TextButton}"
                    HorizontalOptions="Fill"
                    Command="{Binding UseOtherAccountCommand}" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
