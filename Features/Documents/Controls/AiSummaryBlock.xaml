<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrquestadorFrontend.Features.Documents.Controls.AiSummaryBlock"
             x:Name="Root">

    <!--
        AI summary block. Visual distinction makes the IA origin obvious to
        the user: the summary is help-text, never a replacement for the
        original document (Propuesta 1 §9.1, Propuesta 2 §4.4).
    -->
    <Border Stroke="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}"
            StrokeThickness="1"
            BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryContainer}, Dark={StaticResource DarkSecondaryContainer}}"
            Padding="16">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="8">
            <Label Text="Resumen generado por IA"
                   Style="{StaticResource LabelMedium}"
                   TextColor="{AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource DarkOnSecondaryContainer}}" />
            <Label Text="{Binding Summary, Source={x:Reference Root}}"
                   Style="{StaticResource BodyMedium}"
                   TextColor="{AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource DarkOnSecondaryContainer}}" />
            <Label Text="Asistencia a la lectura. El documento original es la fuente."
                   Style="{StaticResource BodySmall}"
                   TextColor="{AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource DarkOnSecondaryContainer}}"
                   Opacity="0.85" />
        </VerticalStackLayout>
    </Border>

</ContentView>
