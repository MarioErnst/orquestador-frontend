<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OrquestadorFrontend.Features.Documents"
             xmlns:shared="clr-namespace:OrquestadorFrontend.Shared.Controls"
             xmlns:models="clr-namespace:OrquestadorFrontend.Data.Models"
             x:Class="OrquestadorFrontend.Features.Documents.DocumentsListPage"
             x:DataType="vm:DocumentsListViewModel"
             Title="Documentos"
             BackgroundColor="{StaticResource Background}">

    <Grid Padding="16">
        <shared:LoadingState IsVisible="{Binding State, Converter={StaticResource IsLoadingConverter}}" />
        <shared:ErrorState   IsVisible="{Binding State, Converter={StaticResource IsFailureConverter}}"
                             Message="{Binding State, Converter={StaticResource FailureMessageConverter}}"
                             RetryCommand="{Binding LoadCommand}" />
        <shared:EmptyState   IsVisible="{Binding State, Converter={StaticResource IsEmptyConverter}}"
                             Title="Sin documentos disponibles"
                             Message="Cuando se publiquen informes para tu rol, aparecerán acá." />

        <CollectionView IsVisible="{Binding State, Converter={StaticResource IsDataConverter}}"
                        ItemsSource="{Binding State, Converter={StaticResource DataValueConverter}}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Report">
                    <Border Style="{StaticResource CardBorder}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsListViewModel}}, Path=OpenDocumentCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding Title}"
                                       Style="{StaticResource TitleMedium}" />
                                <Label Text="{Binding Description}"
                                       Style="{StaticResource BodySmall}"
                                       TextColor="{StaticResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    Stroke="Transparent"
                                    BackgroundColor="{StaticResource PrimaryContainer}"
                                    Padding="10,4"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Kind, Converter={StaticResource ReportKindLabelConverter}}"
                                       Style="{StaticResource LabelSmall}"
                                       TextColor="{StaticResource OnPrimaryContainer}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
