<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OrquestadorFrontend.Features.Profile"
             xmlns:shared="clr-namespace:OrquestadorFrontend.Shared.Controls"
             x:Class="OrquestadorFrontend.Features.Profile.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Perfil"
             Shell.TabBarIsVisible="False">

    <Shell.TitleView>
        <shared:AppBarTitle Title="Mi perfil" />
    </Shell.TitleView>

    <Grid>
        <shared:LoadingState IsVisible="{Binding State, Converter={StaticResource IsLoadingConverter}}" />
        <shared:ErrorState   IsVisible="{Binding State, Converter={StaticResource IsFailureConverter}}"
                             Message="{Binding State, Converter={StaticResource FailureMessageConverter}}"
                             RetryCommand="{Binding LoadCommand}" />

        <ScrollView IsVisible="{Binding State, Converter={StaticResource IsDataConverter}}">
            <VerticalStackLayout Spacing="0">

                <!--
                    Hero section: full-width brand surface with circular avatar
                    showing the user's initials. No photo is stored or transmitted;
                    initials are derived locally from the display name.
                -->
                <Border x:Name="HeroSection"
                        Padding="24,32,24,28"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryContainer}, Dark={StaticResource DarkPrimaryContainer}}"
                        Opacity="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,28,28" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14" HorizontalOptions="Center">

                        <!-- Avatar circle -->
                        <Border WidthRequest="80"
                                HeightRequest="80"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="40" />
                            </Border.StrokeShape>
                            <Label Text="{Binding Initials}"
                                   FontFamily="ACHSNuevaSans"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource DarkOnPrimary}}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="{Binding ProfileData.FullName}"
                                   Style="{StaticResource HeadlineSmall}"
                                   TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainer}, Dark={StaticResource DarkOnPrimaryContainer}}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding ProfileData.Position}"
                                   Style="{StaticResource BodyMedium}"
                                   TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainer}, Dark={StaticResource DarkOnPrimaryContainer}}"
                                   Opacity="0.8"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding RoleLabel}"
                                   Style="{StaticResource LabelMedium}"
                                   TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainer}, Dark={StaticResource DarkOnPrimaryContainer}}"
                                   Opacity="0.65"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="CardsSection"
                                     Padding="16,20,16,32"
                                     Spacing="16"
                                     Opacity="0">

                    <!-- Identity details card -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Información de cuenta"
                                   Style="{StaticResource TitleSmall}"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}" />

                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource DarkOutlineVariant}}" />

                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                                  RowSpacing="12" ColumnSpacing="16">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="Correo"
                                       Style="{StaticResource LabelMedium}"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}"
                                       VerticalOptions="Center" />
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding ProfileData.Email}"
                                       Style="{StaticResource BodyMedium}"
                                       VerticalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="Rol"
                                       Style="{StaticResource LabelMedium}"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}"
                                       VerticalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding RoleLabel}"
                                       Style="{StaticResource BodyMedium}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Appearance preference -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Apariencia"
                                   Style="{StaticResource TitleSmall}"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}" />
                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource DarkOutlineVariant}}" />
                            <Label Text="Elegí cómo se ve la app. Sistema sigue el modo de tu teléfono."
                                   Style="{StaticResource BodySmall}"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}" />
                            <VerticalStackLayout Spacing="4">
                                <RadioButton Content="Sistema"
                                             GroupName="appearance"
                                             IsChecked="{Binding IsAppearanceSystem, Mode=TwoWay}" />
                                <RadioButton Content="Claro"
                                             GroupName="appearance"
                                             IsChecked="{Binding IsAppearanceLight, Mode=TwoWay}" />
                                <RadioButton Content="Oscuro"
                                             GroupName="appearance"
                                             IsChecked="{Binding IsAppearanceDark, Mode=TwoWay}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="Cerrar sesión"
                            Style="{StaticResource OutlinedButton}"
                            Command="{Binding SignOutCommand}" />

                    <Label Text="La gestión de identidad y permisos vive en los servicios corporativos. Esta pantalla solo refleja tu sesión activa."
                           Style="{StaticResource BodySmall}"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource DarkOnSurfaceVariant}}"
                           HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
